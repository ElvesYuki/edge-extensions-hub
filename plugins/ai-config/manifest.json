{
  "manifest_version": 3,
  "name": "ai-config",
  "version": "1.0.0",
  "description": "AI scoring algorithm configuration editor for experiments.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "AI Config Editor"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["page/*", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
